diff --git a/kernel/proc.c b/kernel/proc.c
index 31f23a3..64f2c58 100644
--- a/kernel/proc.c
+++ b/kernel/proc.c
@@ -701,3 +701,18 @@ procdump(void)
     printk("\n");
   }
 }
+int
+getprocs(void)
+{
+  struct proc *p;
+  int count = 0;
+
+  for(p = proc; p < &proc[NPROC]; p++){
+    acquire(&p->lock);
+   if(p->state == RUNNABLE || p->state == RUNNING)
+      count++;
+    release(&p->lock);
+  }
+
+  return count;
+}
